/* 'O Sistema — UI design system.
   Dark, warm panels; gold accent (Neapolitan tuff and church gilt); red for danger. */

.root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: #EDE6D6;
    font-size: 13px;
}

.layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ---------- Panels ---------- */

.panel {
    background-color: rgba(20, 17, 14, 0.9);
    border-width: 1px;
    border-color: rgba(232, 194, 106, 0.18);
    border-radius: 6px;
    padding: 8px 10px;
}

.panel--flat {
    background-color: rgba(20, 17, 14, 0.78);
    border-width: 0;
}

.title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #F3E9D2;
}

.subtitle {
    font-size: 11px;
    color: #A89F8E;
}

.section {
    font-size: 13px;
    -unity-font-style: bold;
    color: #E8C26A;
    margin-top: 10px;
    margin-bottom: 4px;
    letter-spacing: 1px;
}

.muted { color: #A89F8E; }
.good { color: #8FD18A; }
.bad { color: #F07A6E; }
.warn { color: #F2B866; }
.gold { color: #E8C26A; }
.small { font-size: 11px; }
.bold { -unity-font-style: bold; }
.wrap { white-space: normal; }

.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.grow { flex-grow: 1; }
.spacer { flex-grow: 1; }

/* ---------- Buttons ---------- */

.btn {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    color: #EDE6D6;
    padding: 4px 10px;
    margin: 2px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.btn:hover {
    background-color: rgba(232, 194, 106, 0.18);
    border-color: rgba(232, 194, 106, 0.5);
}

.btn:active {
    background-color: rgba(232, 194, 106, 0.32);
}

.btn--on {
    background-color: rgba(232, 194, 106, 0.28);
    border-color: #E8C26A;
    color: #FFF4DA;
}

.btn--danger:hover {
    background-color: rgba(240, 122, 110, 0.25);
    border-color: #F07A6E;
}

.btn--small {
    font-size: 11px;
    padding: 2px 6px;
    margin: 1px;
}

.btn:disabled {
    opacity: 0.35;
}

/* ---------- Top bar ---------- */

.clock {
    position: absolute;
    left: 8px; top: 8px;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
}

.clock__day { font-size: 11px; color: #A89F8E; margin-right: 8px; }
.clock__time { font-size: 18px; -unity-font-style: bold; color: #F3E9D2; margin-right: 8px; }

.speed-btn {
    width: 40px;
    height: 24px;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
}

.resources {
    position: absolute;
    top: 8px;
    left: 360px;
    right: 290px;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 17, 14, 0.8);
    border-radius: 11px;
    padding: 2px 9px 2px 6px;
    margin: 0 2px;
}

.chip__dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 6px;
}

.chip__value { -unity-font-style: bold; font-size: 13px; }
.chip__label { font-size: 10px; color: #A89F8E; margin-left: 4px; }

.family {
    position: absolute;
    right: 8px; top: 8px;
    width: 270px;
    padding: 5px 9px;
}

/* ---------- Bars ---------- */

.bar {
    height: 8px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 4px;
    overflow: hidden;
    margin: 2px 0 4px 0;
}

.bar--thin { height: 4px; margin: 1px 0; }

.bar__fill {
    height: 100%;
    border-radius: 4px;
}

.bar-label {
    flex-direction: row;
    justify-content: space-between;
    font-size: 11px;
}

/* ---------- Crew bar ---------- */

.crew-bar {
    position: absolute;
    left: 8px; top: 52px;
    width: 160px;
}

.crew-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 17, 14, 0.72);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    border-radius: 5px;
    padding: 3px 5px;
    margin-bottom: 3px;
    transition-property: border-color, background-color;
    transition-duration: 0.1s;
}

.crew-card:hover { border-color: rgba(232, 194, 106, 0.5); }
.crew-card--selected { border-color: #E8C26A; background-color: rgba(60, 48, 26, 0.9); }
.crew-card--drafted { border-left-width: 3px; border-left-color: #F07A6E; }

.avatar {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.6);
    margin-right: 7px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.9);
}

.avatar--big { width: 48px; height: 48px; border-radius: 24px; font-size: 18px; }

.crew-card__name { -unity-font-style: bold; font-size: 11px; }
.crew-card__status { font-size: 9px; color: #A89F8E; }

/* ---------- Feed ---------- */

.feed {
    position: absolute;
    right: 8px; top: 160px;
    width: 270px;
}

.toast {
    background-color: rgba(20, 17, 14, 0.8);
    border-left-width: 3px;
    border-left-color: #A89F8E;
    border-radius: 4px;
    padding: 3px 7px;
    margin-bottom: 3px;
    white-space: normal;
    font-size: 11px;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.toast--good { border-left-color: #8FD18A; }
.toast--bad { border-left-color: #F07A6E; }

/* ---------- Dock ---------- */

.dock {
    position: absolute;
    bottom: 10px;
    left: 0; right: 0;
    align-items: center;
}

.dock__tools {
    flex-direction: row;
    margin-bottom: 4px;
}

.dock__tabs {
    flex-direction: row;
    align-items: center;
}

.tool {
    width: 78px;
    height: 46px;
    padding: 4px;
    align-items: center;
    justify-content: center;
}

.tool__swatch {
    width: 22px;
    height: 14px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
    margin-bottom: 3px;
}

.tool__label { font-size: 11px; }

.tab { min-width: 84px; height: 26px; font-size: 11px; -unity-font-style: bold; }

/* ---------- Inspector ---------- */

.inspector {
    position: absolute;
    left: 8px; bottom: 8px;
    width: 290px;
    max-height: 360px;
    padding: 8px 10px;
}
.insp-head { align-items: center; }
.insp-name { font-size: 14px; -unity-font-style: bold; color: #F1E6CF; }
.insp-chevron { font-size: 14px; color: #A89F8E; margin-left: 6px; }
.insp-tabs {
    margin-top: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(232, 194, 106, 0.18);
}
.insp-tab {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    font-size: 11px;
    color: #A89F8E;
    padding: 3px 8px;
    margin: 0;
}
.insp-tab:hover { color: #F1E6CF; }
.insp-tab--on { color: #FFF4DA; border-bottom-color: #E8C26A; }
.insp-page { padding-top: 6px; }

.thought { font-size: 11px; margin: 1px 0; }

/* ---------- Windows ---------- */

.window {
    background-color: rgba(20, 17, 14, 0.97);
    position: absolute;
    left: 50%;
    top: 70px;
    bottom: 110px;
    width: 760px;
    translate: -50% 0;
    padding: 0;
}

.window__header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(232, 194, 106, 0.18);
}

.window__body { padding: 8px 14px; flex-grow: 1; }

.table-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

/* ---------- Event card ---------- */

.dim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.card {
    width: 600px;
    padding: 0;
    border-color: rgba(232, 194, 106, 0.45);
}

.card__band {
    height: 92px;
    background-color: rgb(60, 36, 24);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    justify-content: flex-end;
    padding: 12px 18px;
}

.card__title { font-size: 22px; -unity-font-style: bold; color: #FFF4DA; }
.card__body { padding: 14px 18px 16px 18px; }
.card__quote { font-size: 18px; -unity-font-style: italic; color: #E8C26A; white-space: normal; }
.card__sub { font-size: 12px; -unity-font-style: italic; color: #A89F8E; margin-bottom: 10px; white-space: normal; }
.card__text { font-size: 13px; white-space: normal; margin-bottom: 12px; }

.option {
    padding: 8px 12px;
    margin: 3px 0;
    align-items: flex-start;
    -unity-text-align: middle-left;
}

.option__label { font-size: 14px; -unity-font-style: bold; }
.option__hint { font-size: 11px; color: #A89F8E; white-space: normal; }

/* ---------- Alert banner ---------- */

.alert {
    position: absolute;
    top: 64px;
    left: 50%;
    translate: -50% 0;
    background-color: rgba(150, 20, 16, 0.92);
    border-radius: 6px;
    padding: 8px 28px;
    font-size: 26px;
    -unity-font-style: bold;
    color: #FFF0E6;
    letter-spacing: 6px;
    transition-property: opacity;
    transition-duration: 0.6s;
}

/* ---------- World labels ---------- */

.tag {
    position: absolute;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #F3E9D2;
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    translate: -50% 0;
}

.tag--rival { color: #FF8A7E; }
.tag--boss { color: #E8C26A; }
.tag--police { color: #9DB8FF; }
.tag--place { color: #E8C26A; font-size: 10px; }

.bubble {
    position: absolute;
    background-color: rgba(250, 244, 230, 0.95);
    border-radius: 8px;
    padding: 4px 9px;
    translate: -50% -100%;
    max-width: 260px;
}

.bubble__nap { color: #2A1D14; font-size: 13px; -unity-font-style: bold; white-space: normal; }
.bubble__en { color: #6B5E4E; font-size: 10px; -unity-font-style: italic; white-space: normal; }

.tooltip {
    position: absolute;
    background-color: rgba(12, 10, 8, 0.95);
    border-width: 1px;
    border-color: rgba(232, 194, 106, 0.35);
    border-radius: 4px;
    padding: 6px 8px;
    max-width: 280px;
    white-space: normal;
    font-size: 11px;
}


/* ---------- Menus ---------- */

.menu {
    width: 380px;
    padding: 0;
    border-color: rgba(232, 194, 106, 0.45);
}

.menu__title { font-size: 34px; -unity-font-style: bold; color: #E8C26A; letter-spacing: 3px; }
.menu__sub { font-size: 12px; -unity-font-style: italic; color: #A89F8E; }
.menu__body { padding: 14px 18px 18px 18px; }
.menu-btn { height: 34px; font-size: 14px; margin: 3px 0; }

.setting { flex-direction: row; align-items: center; margin: 4px 0; }
.setting__label { width: 130px; }

.popup { color: #8FD18A; font-size: 13px; }


/* ---------- Top bar (v2) ---------- */

.topbar {
    position: absolute;
    left: 0; top: 0; right: 0;
    height: 40px;
    flex-direction: row;
    align-items: center;
    padding: 0 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(232, 194, 106, 0.35);
}

.topbar__section {
    flex-direction: row;
    align-items: center;
}

.topbar .clock__time { font-size: 18px; margin: 0 8px 0 6px; }
.topbar .clock__day { font-size: 10px; letter-spacing: 1px; margin-right: 10px; }
.topbar .speed-btn { width: 30px; height: 22px; align-items: center; justify-content: center; }
.topbar .chip { background-color: rgba(0, 0, 0, 0); padding: 0 6px; margin: 0 2px; }
.topbar .chip__value { margin-left: 5px; }

.divider {
    width: 1px;
    height: 20px;
    background-color: rgba(232, 194, 106, 0.25);
    margin: 0 8px;
}

.badge {
    background-color: rgba(232, 194, 106, 0.18);
    border-width: 1px;
    border-color: rgba(232, 194, 106, 0.6);
    border-radius: 3px;
    color: #E8C26A;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding: 2px 7px;
    margin-right: 8px;
}

.tiny { font-size: 9px; color: #A89F8E; letter-spacing: 1px; }

/* Layout below the bar */
.family { top: 46px; right: 8px; width: 290px; padding: 6px 10px; }
.crew-bar { top: 46px; }
.feed { top: 178px; width: 290px; }

/* Dock (v2): icon buttons */
.tab { flex-direction: row; align-items: center; justify-content: center; min-width: 96px; height: 32px; }
.tab .tab__label { margin-left: 6px; font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; }
.dock__tabs { padding: 4px 6px; }
.panel { border-color: rgba(232, 194, 106, 0.22); }

.build-hint {
    background-color: rgba(10, 8, 6, 0.85);
    border-radius: 3px;
    padding: 3px 10px;
    margin-bottom: 4px;
    font-size: 11px;
}
.panel { border-top-color: rgba(232, 194, 106, 0.45); }
.tool { border-width: 1px; border-color: rgba(255, 255, 255, 0.05); }
.tool:hover { border-color: rgba(232, 194, 106, 0.5); }
.op-card {
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(232, 194, 106, 0.2);
    border-radius: 4px;
    padding: 5px 7px;
    margin-bottom: 4px;
}

/* ---------- Typography (Barlow, SIL OFL: Resources/Fonts/OFL.txt) ---------- */

.root, .root .unity-text-element {
    -unity-font: resource("Fonts/Barlow-Medium");
    -unity-font-definition: resource("Fonts/Barlow-Medium");
}

.root .bold, .root .chip__value, .root .crew-card__name, .root .btn {
    -unity-font-definition: resource("Fonts/Barlow-Bold");
    -unity-font-style: normal;
}

/* Display face: condensed, for headings, the clock, badges and tabs */
.root .title, .root .section, .root .clock__time, .root .badge, .root .tab__label,
.root .card__title, .root .menu__title, .root .tiny, .root .clock__day {
    -unity-font-definition: resource("Fonts/BarlowCondensed-SemiBold");
    -unity-font-style: normal;
}

.root .title { font-size: 19px; letter-spacing: 0.5px; }
.root .section { letter-spacing: 2px; }
.root .clock__time { font-size: 21px; }
.root .card__title { font-size: 26px; }
.root .menu__title {
    -unity-font-definition: resource("Fonts/BarlowCondensed-Bold");
    font-size: 44px;
    letter-spacing: 6px;
}


/* ---------- Phone ---------- */

.phone {
    position: absolute;
    right: 12px; bottom: 76px;
    width: 350px; height: 560px;
    background-color: rgb(16, 15, 16);
    border-width: 3px;
    border-color: rgb(52, 50, 52);
    border-radius: 22px;
    padding: 10px 8px 14px 8px;
}
.phone__head { flex-direction: row; align-items: center; padding: 0 6px 4px 6px; }
.phone__title { margin-left: 6px; font-size: 13px; letter-spacing: 2px; color: #E8C26A; }
.phone__line { font-size: 10px; color: #A89F8E; padding: 0 8px 6px 8px; border-bottom-width: 1px; border-bottom-color: rgba(255,255,255,0.06); }
.phone__body { flex-grow: 1; margin-top: 6px; }
.msg {
    background-color: rgb(34, 31, 30);
    border-radius: 10px;
    padding: 7px 9px;
    margin: 0 4px 6px 4px;
    border-left-width: 3px;
    border-left-color: rgba(255,255,255,0.06);
}
.msg--open { border-left-color: #E8C26A; background-color: rgb(44, 38, 30); }
.msg__from { -unity-font-style: bold; color: #F3E9D2; font-size: 12px; }
.msg__nap { -unity-font-style: italic; color: #E8D6B0; font-size: 12px; margin-top: 2px; }
.msg__choice { margin-top: 4px; align-self: flex-start; }
.msg__answer { font-size: 11px; color: #8FD18A; margin-top: 3px; }
.tab--alert { border-color: #E8C26A; }

/* ---------- La Sirena ---------- */

.paper {
    width: 720px;
    background-color: rgb(236, 229, 212);
    border-radius: 2px;
    padding: 18px 26px 16px 26px;
    color: rgb(30, 27, 24);
}
.paper__mast { align-items: center; border-bottom-width: 3px; border-bottom-color: rgb(30, 27, 24); padding-bottom: 6px; margin-bottom: 10px; }
.root .paper__name { -unity-font-definition: resource("Fonts/BarlowCondensed-Bold"); -unity-font-style: normal; font-size: 46px; letter-spacing: 10px; color: rgb(30, 27, 24); }
.paper__dateline { font-size: 11px; color: rgb(80, 72, 64); border-top-width: 1px; border-top-color: rgb(30, 27, 24); padding-top: 3px; }
.root .paper__headline { -unity-font-definition: resource("Fonts/BarlowCondensed-Bold"); -unity-font-style: normal; font-size: 32px; color: rgb(20, 18, 16); white-space: normal; }
.paper__lead { font-size: 15px; color: rgb(40, 36, 32); margin: 4px 0 12px 0; white-space: normal; }
.paper__cols { flex-direction: row; border-top-width: 1px; border-top-color: rgb(120, 110, 100); padding-top: 8px; }
.paper__col { flex-grow: 1; flex-basis: 0; padding-right: 14px; }
.root .paper__colhead { -unity-font-definition: resource("Fonts/BarlowCondensed-SemiBold"); -unity-font-style: normal; font-size: 17px; color: rgb(20, 18, 16); white-space: normal; }
.paper__text { font-size: 12px; color: rgb(55, 50, 45); white-space: normal; }
.paper__foot { border-top-width: 1px; border-top-color: rgb(120, 110, 100); margin-top: 10px; padding-top: 6px; }
.paper__sidebar { -unity-font-style: italic; color: rgb(120, 30, 24); }
.paper__close { margin-top: 12px; }

.tag--work {
    color: #1A1410;
    background-color: #E8C26A;
    border-radius: 3px;
    padding: 0 5px;
    -unity-font-style: bold;
}

/* ---------- Minigames ---------- */
.minigame { width: 860px; padding: 14px 18px; }
.root .minigame__readout {
    -unity-font-definition: resource("Fonts/BarlowCondensed-Bold");
    font-size: 26px;
    color: #8FE08A;
    background-color: #101410;
    padding: 2px 12px;
    border-radius: 3px;
}
.root .pack__brand {
    position: absolute; left: 55px; top: 24px; width: 110px;
    -unity-text-align: middle-center;
    -unity-font-definition: resource("Fonts/BarlowCondensed-Bold");
    font-size: 30px; letter-spacing: 4px; color: #F4F0E6;
}
.root .pack__warning {
    position: absolute; left: 62px; top: 150px; width: 96px;
    -unity-text-align: middle-center;
    -unity-font-definition: resource("Fonts/Barlow-Bold");
    font-size: 11px; color: #F4F0E6;
}

/* ---------- Minimap, map, objective ---------- */
.minimap {
    position: absolute; top: 46px; right: 8px;
    width: 290px; height: 170px;
    padding: 0; overflow: hidden;
    border-width: 1px; border-color: rgba(232, 194, 106, 0.45);
    background-color: rgb(18, 17, 16);
}
.minimap__image, .bigmap__image { position: absolute; -unity-background-scale-mode: stretch-to-fill; }
.bigmap__image { position: relative; }
.bigmap { padding: 12px 16px; }
.goal {
    position: absolute; top: 220px; right: 8px; width: 290px;
    background-color: rgba(10, 8, 6, 0.86);
    border-left-width: 3px; border-left-color: #E8C26A;
    padding: 4px 8px; font-size: 12px; white-space: normal;
}
.family { top: 252px; }
.feed { top: 252px; }
.dot {
    position: absolute; width: 6px; height: 6px; margin-left: -3px; margin-top: -3px;
    border-radius: 3px; background-color: white;
}
.dot--you { width: 9px; height: 9px; margin-left: -4px; margin-top: -4px; border-radius: 5px; background-color: #FFFFFF; border-width: 2px; border-color: #000000; }
.dot--crew { background-color: #6FA8E8; }
.dot--work { background-color: #E8C26A; }
.dot--goal { width: 10px; height: 10px; margin-left: -5px; margin-top: -5px; border-radius: 1px; rotate: 45deg; background-color: #F2D27A; border-width: 1px; border-color: #3A2A10; }
.dot--home { background-color: #8FD18A; border-radius: 1px; }
.dot--piazza { background-color: #C25BD8; }
.dot--police { background-color: #F07A6E; }
.goal-marker {
    position: absolute; font-size: 22px; color: #F2D27A;
    translate: -50% -50%;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.9);
}
.tab__key {
    margin-left: 5px; font-size: 9px; color: #A89F8E;
    border-width: 1px; border-color: rgba(168, 159, 142, 0.5); border-radius: 2px; padding: 0 3px;
}

/* ---------- Vitals, status, chase ---------- */
.vitals-strip { margin-left: 8px; }
.vitals-strip .chip { padding: 0 4px; }
.status-box {
    position: absolute; top: 30%; left: 50%; translate: -50% 0;
    width: 420px; padding: 12px 16px;
    border-color: rgba(240, 122, 110, 0.6);
}
.wanted {
    position: absolute; top: 52px; left: 50%; translate: -50% 0;
    width: 340px; align-items: center;
    background-color: rgba(30, 40, 110, 0.9);
    border-width: 2px; border-color: #F07A6E; border-radius: 4px;
    padding: 6px 12px;
}
.root .wanted__title {
    -unity-font-definition: resource("Fonts/BarlowCondensed-Bold");
    font-size: 24px; letter-spacing: 3px; color: #FFFFFF;
}

.paper { max-height: 92%; overflow: hidden; }
.paper__close { position: absolute; right: 8px; top: 8px; }

.dot--pin { width: 10px; height: 10px; margin-left: -5px; margin-top: -5px; border-radius: 5px; background-color: #6FE0E8; border-width: 2px; border-color: #0A2A2E; }
.dot--contact { background-color: #CFC6B4; }
.dot--shop { background-color: #9DD0F0; border-radius: 1px; }
.dot--home { width: 9px; height: 9px; margin-left: -4px; margin-top: -4px; background-color: #8FD18A; border-radius: 2px; border-width: 1px; border-color: #1E3A1C; }
.pin-marker { color: #6FE0E8; font-size: 18px; }
.map-label { position: absolute; font-size: 10px; color: #F3E9D2; text-shadow: 1px 1px 1px rgba(0,0,0,1); white-space: nowrap; }

/* ---------- Shifts ---------- */
.shift-hour { width: 18px; -unity-text-align: middle-left; }
.shift-cell { width: 16px; height: 16px; margin: 1px; border-radius: 2px; }
.shift-cell--now { border-width: 1px; border-color: #FFFFFF; }
.shift--work { background-color: #B8913E; }
.shift--sleep { background-color: #3E5C8F; }
.shift--free { background-color: #4C4740; }
.btn.shift--work, .btn.shift--sleep, .btn.shift--free { color: #F3E9D2; }

/* ---------- Build menu ---------- */
.tool { width: 82px; height: 86px; }
.tool__picture { width: 40px; height: 40px; border-width: 0; border-radius: 3px; background-color: rgba(0,0,0,0.35); -unity-background-scale-mode: scale-to-fit; }
.tool__price { font-size: 10px; color: #E8C26A; }

/* ---------- Portraits ---------- */
.avatar--portrait { -unity-background-scale-mode: scale-and-crop; border-color: rgba(232, 194, 106, 0.6); }
.card__portrait { width: 84px; height: 84px; margin-right: 14px; border-radius: 4px; border-width: 2px; border-color: rgba(0,0,0,0.6); -unity-background-scale-mode: scale-and-crop; flex-shrink: 0; }

/* ---------- Character creator ---------- */
.creator { width: 900px; }
.creator__portrait { width: 170px; height: 170px; margin-right: 12px; border-radius: 4px; border-width: 2px; border-color: rgba(232,194,106,0.5); -unity-background-scale-mode: scale-and-crop; background-color: #111; }
.creator__preview { width: 170px; height: 170px; border-radius: 4px; background-color: rgb(78, 76, 82); margin-bottom: 8px; }
.creator__layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }

.namefield { flex-grow: 1; height: 24px; padding: 2px 8px; margin: 2px 0; background-color: #15120F; border-width: 1px; border-color: rgba(232,194,106,0.25); border-radius: 3px; justify-content: center; }
.namefield--on { border-color: #E8C26A; background-color: #211B14; }

/* ---------- Action cues ---------- */
.action { position: absolute; translate: -50% -100%; align-items: center; background-color: rgba(10,8,6,0.82); border-radius: 3px; padding: 2px 6px; }
.action__label { font-size: 10px; color: #F3E9D2; white-space: nowrap; }
.action__bar { width: 70px; height: 4px; margin-top: 2px; background-color: rgba(255,255,255,0.15); border-radius: 2px; overflow: hidden; }
.action__fill { height: 100%; background-color: #E8C26A; }
.tag--sleep { color: #A9C6FF; font-size: 13px; -unity-font-style: bold; background-color: rgba(0,0,0,0); }

.shop { width: 560px; }

/* ---------- Map icons ---------- */
.map-icon { position: absolute; width: 14px; height: 14px; margin-left: -7px; margin-top: -7px; border-radius: 7px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: #FFFFFF; border-width: 1px; border-color: rgba(0,0,0,0.8); padding: 0; }
.map-icon--big { width: 18px; height: 18px; margin-left: -9px; margin-top: -9px; border-radius: 9px; font-size: 11px; }
.icon--home { background-color: #4E9A4A; }
.icon--hospital { background-color: #D23C34; }
.icon--church { background-color: #8A7D6A; }
.icon--pizza { background-color: #E07A2E; }
.icon--bar { background-color: #8A56B8; }
.icon--tabacchi { background-color: #3C6FB8; }
.icon--salumeria { background-color: #C4A23A; }
.icon--farmacia { background-color: #3AA36A; }
.icon--macelleria { background-color: #A8343C; }
.icon--mobili { background-color: #8A5A32; }
.icon--lusso { background-color: #2FA7B5; }
.icon--moto { background-color: #3B4A6B; }
.icon--shop { background-color: #6A6460; }
.icon--work { background-color: #E8C26A; color: #1A1410; }
.icon--contact { background-color: #CFC6B4; color: #1A1410; }

.role-menu { position: absolute; padding: 4px; min-width: 200px; }
.role-menu__item { margin: 1px 0; -unity-text-align: middle-left; }

.namefield { height: 28px; padding: 0 10px; flex-direction: row; align-items: center; }
.namefield__text { margin: 0; padding: 0; -unity-text-align: middle-left; font-size: 14px; flex-grow: 1; }
.creator__preview { -unity-background-scale-mode: scale-and-crop; border-width: 2px; border-color: rgba(232,194,106,0.5); }

.map-legend { width: 210px; margin-left: 14px; }
.map-icon--legend { position: relative; margin: 0 10px 0 0; width: 18px; height: 18px; border-radius: 9px; font-size: 11px; }

/* ---------- Famiglia: sidebar of sections, the open one on the right ---------- */
.window--famiglia { width: 900px; }
.famiglia { flex-direction: row; flex-grow: 1; min-height: 0; }
.famiglia__nav {
    width: 200px;
    padding: 8px 6px;
    border-right-width: 1px;
    border-right-color: rgba(232, 194, 106, 0.18);
    background-color: rgba(0, 0, 0, 0.18);
}
.famiglia__item {
    padding: 7px 10px;
    margin-bottom: 2px;
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}
.famiglia__item:hover { background-color: rgba(255, 255, 255, 0.06); }
.famiglia__item--on {
    background-color: rgba(232, 194, 106, 0.16);
    border-left-color: #E8C26A;
}
.famiglia__name { font-size: 13px; -unity-font-style: bold; color: #F1E6CF; }
.famiglia__item--on .famiglia__name { color: #FFF4DA; }
.famiglia__status { font-size: 10px; color: #A89F8E; white-space: normal; }
.famiglia__main { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.famiglia__head {
    padding: 10px 14px 8px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}
.famiglia__title { font-size: 16px; -unity-font-style: bold; color: #E8C26A; letter-spacing: 1px; }

.stat-card {
    width: 150px;
    margin: 0 8px 8px 0;
    padding: 8px 10px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}
.stat-card__value { font-size: 20px; -unity-font-style: bold; color: #FFF4DA; }

.attention {
    flex-direction: row;
    align-items: center;
    padding: 7px 10px;
    margin-bottom: 4px;
    border-radius: 4px;
    border-left-width: 3px;
    background-color: rgba(255, 255, 255, 0.04);
}
.attention:hover { background-color: rgba(255, 255, 255, 0.09); }
.attention--bad { border-left-color: #F07A6E; }
.attention--warn { border-left-color: #F2B866; }

/* Painted map icons: the picture is the whole icon. */
.map-icon--art { background-color: rgba(0, 0, 0, 0); border-width: 0; -unity-background-scale-mode: scale-to-fit; width: 18px; height: 18px; margin-left: -9px; margin-top: -9px; }
.map-icon--big.map-icon--art { width: 24px; height: 24px; margin-left: -12px; margin-top: -12px; }
.map-icon--legend.map-icon--art { width: 22px; height: 22px; margin: 0 8px 0 0; }

/* ---------- The burner phone: an old candybar with a green LCD ---------- */
.nokia {
    position: absolute;
    right: 16px; bottom: 76px;
    width: 236px;
    padding: 14px 16px 18px 16px;
    background-color: #2B2F33;
    border-radius: 38px 38px 30px 30px;
    border-width: 2px;
    border-color: #15181A;
    border-top-color: #4A5056;
    align-items: center;
}
.nokia__ear { width: 54px; height: 6px; border-radius: 3px; background-color: #121416; margin-bottom: 6px; }
.nokia__brand { font-size: 10px; letter-spacing: 3px; color: #9AA0A6; -unity-font-style: bold; margin-bottom: 6px; }
.nokia__screen {
    width: 196px;
    height: 214px;
    padding: 6px 7px 4px 7px;
    background-color: #9DB06B;
    border-width: 4px;
    border-color: #1B1E20;
    border-radius: 6px;
}
.lcd { color: #1E2A10; font-size: 11px; }
.lcd__status { font-size: 9px; letter-spacing: 1px; margin-bottom: 2px; -unity-text-align: middle-center; }
.lcd__body { flex-grow: 1; }
.lcd__title { -unity-font-style: bold; border-bottom-width: 1px; border-bottom-color: #1E2A10; margin-bottom: 3px; }
.lcd__row { padding: 1px 3px; }
.lcd__row--sel { background-color: #1E2A10; color: #9DB06B; }
.lcd__row:hover { background-color: rgba(30, 42, 16, 0.25); }
.lcd__row--sel:hover { background-color: #1E2A10; }
.lcd__clock { font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; margin-top: 18px; }
.lcd__center { -unity-text-align: middle-center; }
.lcd__nap { -unity-font-style: italic; margin-bottom: 2px; }
.lcd__small { font-size: 9px; }
.lcd__soft { border-top-width: 1px; border-top-color: rgba(30, 42, 16, 0.5); padding-top: 1px; }
.lcd__softkey { font-size: 10px; -unity-font-style: bold; }
.nokia__navrow { margin-top: 10px; align-items: center; }
.nokia__soft {
    width: 40px; height: 16px; border-radius: 8px;
    background-color: #3D4248; border-width: 1px; border-color: #1A1D20; margin: 0 4px;
}
.nokia__nav { align-items: center; }
.nokia__navkey {
    width: 52px; height: 18px; margin: 1px; padding: 0;
    font-size: 9px; color: #C9CED3;
    background-color: #3D4248; border-width: 1px; border-color: #1A1D20; border-radius: 9px;
}
.nokia__ok { background-color: #4A5057; -unity-font-style: bold; }
.nokia__callrow { width: 190px; margin-top: 4px; }
.nokia__call { width: 46px; height: 14px; border-radius: 7px; border-width: 1px; border-color: #1A1D20; }
.nokia__call--green { background-color: #3E7A3E; }
.nokia__call--red { background-color: #8A3131; }
.nokia__pad { flex-direction: row; flex-wrap: wrap; width: 192px; margin-top: 8px; justify-content: space-between; }
.nokia__key {
    width: 58px; height: 26px; margin: 2px 0; padding: 0;
    background-color: #3A3F45; border-width: 1px; border-color: #1A1D20; border-radius: 10px;
    flex-direction: row; justify-content: center; align-items: center;
}
.nokia__key:hover { background-color: #4A5057; }
.nokia__digit { font-size: 13px; color: #E6E9EC; -unity-font-style: bold; }
.nokia__letters { font-size: 7px; color: #9AA0A6; margin-left: 3px; }
.shop__pic { width: 44px; height: 56px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; }

/* ---------- Scrollbars: a thin gold line, no arrows, no track ---------- */
.unity-scroller--vertical { width: 6px; margin-left: 2px; }
.unity-scroller--horizontal { height: 0; display: none; }
.unity-scroller .unity-repeat-button { display: none; width: 0; height: 0; }
.unity-scroller .unity-slider { margin: 0; }
.unity-scroller--vertical .unity-slider { margin-top: 0; margin-bottom: 0; }
.unity-scroller .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.04); border-width: 0; border-radius: 3px; }
.unity-scroller .unity-base-slider__dragger { background-color: rgba(232, 194, 106, 0.45); border-width: 0; border-radius: 3px; width: 6px; left: 0; margin: 0; }
.unity-scroller .unity-base-slider__dragger:hover { background-color: rgba(232, 194, 106, 0.75); }
.hour-menu { flex-direction: row; flex-wrap: wrap; width: 264px; }
.hour-menu__item { width: 60px; margin: 1px; }
.bigmap__view { width: 860px; height: 600px; overflow: hidden; position: relative; background-color: rgb(18, 17, 16); border-radius: 4px; }
.bigmap__view .bigmap__image { position: absolute; }
.territory { position: absolute; border-width: 1px; justify-content: center; align-items: center; }
.territory__label { font-size: 10px; color: #FFF4DA; -unity-text-align: middle-center; white-space: normal; text-shadow: 1px 1px 0 rgba(0,0,0,0.8); }

/* ---------- Layout safety: nothing squashes, the long part scrolls ----------
   UI Toolkit shrinks children by default when a column runs out of height, which piles text on text.
   A panel with a size limit carries "fit": its fixed parts keep their natural height and only the
   scroll area inside gives way (and scrolls). Modal cards stay between the top bar and the dock. */
.fit > * { flex-shrink: 0; }
.fit > .unity-scroll-view, .fit > .fit { flex-shrink: 1; min-height: 0; }
.scroll { flex-grow: 1; }
.dim { padding: 52px 16px 76px 16px; }
.dim > * { max-height: 100%; }
.table-row, .card__band, .window__header, .famiglia__head, .insp-head, .insp-tabs, .option, .menu-btn { flex-shrink: 0; }
.card__foot { padding: 8px 18px 14px 18px; border-top-width: 1px; border-top-color: rgba(232, 194, 106, 0.18); }
.card__body--top { padding-bottom: 6px; }
.shop__row { min-height: 52px; padding: 6px 0; }
.shop__info { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 10px; }
.shop__info > * { flex-shrink: 0; }
.shop__name { -unity-font-style: bold; font-size: 14px; }
.shop__note { white-space: normal; margin-top: 1px; }
.shop__stock { margin-top: 1px; }
.shop__stepper { flex-shrink: 0; align-items: center; }
.shop__qty { width: 30px; -unity-text-align: middle-center; }
.shop__total { margin-bottom: 6px; }
.paper__scroll { flex-grow: 1; }
.inspector { flex-direction: column; }
.map-legend { max-height: 600px; flex-shrink: 0; }
.bigmap__view { flex-shrink: 0; }
/* The phone comes out beside the minimap column, not over it. */
.nokia { right: 306px; }
/* Settings: a long label wraps beside its control instead of running under it. */
.setting { flex-shrink: 0; }
.setting__label { width: 180px; flex-shrink: 0; white-space: normal; margin-right: 10px; }
.setting > Slider { flex-shrink: 1; min-width: 0; }
.card__foot .menu-btn { width: 140px; margin-left: 8px; }

/* ---------- Combat: armour plates over the health bar, and where the shot came from ---------- */
.combat-bar { position: absolute; bottom: 70px; left: 50%; translate: -50% 0; width: 250px; align-items: center; }
.combat-bar__seg { width: 100%; height: 6px; margin-bottom: 3px; background-color: rgba(20, 40, 60, 0.7); border-width: 1px; border-color: rgba(0, 0, 0, 0.6); }
.combat-bar__segfill { height: 100%; background-color: #6FC3FF; }
.combat-bar__hp { width: 100%; height: 9px; background-color: rgba(30, 10, 10, 0.75); border-width: 1px; border-color: rgba(0, 0, 0, 0.6); }
.combat-bar__hpfill { height: 100%; background-color: #F2F2EA; }
.hurt-arrow { position: absolute; width: 32px; height: 32px; font-size: 28px; color: #FF3B30; -unity-text-align: middle-center; -unity-font-style: bold; text-shadow: 0 0 4px rgba(0,0,0,0.9); }
.person-menu { min-width: 200px; padding: 6px; }
.status-box--side { top: auto; bottom: 90px; left: 12px; translate: 0 0; width: 380px; }

/* ---------- HUD v3: grouped top bar, attention-only crew bar, diary, sidebar, build drawer ---------- */
.tb-group {
    flex-direction: column; justify-content: center;
    height: 100%; padding: 0 12px;
    border-left-width: 1px; border-left-color: rgba(232, 194, 106, 0.2);
}
.root .tb-cap { font-size: 8px; letter-spacing: 2px; color: #8A806F; margin-bottom: 1px; }
.tb-row { flex-direction: row; align-items: center; }
.topbar .tb-row .chip { padding: 0 5px 0 0; margin: 0 4px 0 0; }
.topbar .tb-row .badge { margin-right: 6px; padding: 1px 6px; }
.badge--bad { color: #F07A6E; border-color: rgba(240, 122, 110, 0.7); background-color: rgba(240, 122, 110, 0.15); margin-left: 6px; }
.mini-bar { flex-direction: row; align-items: center; height: 9px; }
.root .mini-bar__label { font-size: 7px; letter-spacing: 1px; color: #8A806F; width: 36px; }
.mini-bar__track { width: 46px; height: 4px; border-radius: 2px; background-color: rgba(0, 0, 0, 0.55); overflow: hidden; }

.vitals-bar {
    flex-direction: row; align-items: center; align-self: center;
    background-color: rgba(10, 8, 6, 0.72); border-radius: 4px;
    padding: 3px 10px; margin-bottom: 4px;
}
.vital { flex-direction: row; align-items: center; margin-right: 10px; }
.vital__track { width: 54px; height: 5px; margin-left: 5px; border-radius: 3px; background-color: rgba(0, 0, 0, 0.6); overflow: hidden; }
.vital__ammo { font-size: 11px; margin-right: 8px; }

.root .crew-bar__head {
    font-size: 10px; letter-spacing: 1px; color: #E8C26A;
    background-color: rgba(10, 8, 6, 0.8); border-radius: 4px;
    padding: 3px 7px; margin-bottom: 4px;
}
.crew-bar__head:hover { background-color: rgba(60, 48, 26, 0.9); }

.root .diary__head {
    font-size: 10px; letter-spacing: 1px; color: #E8C26A;
    background-color: rgba(10, 8, 6, 0.8); border-radius: 3px;
    padding: 3px 8px; margin-bottom: 3px;
}
.diary__head:hover { background-color: rgba(60, 48, 26, 0.9); }
.diary { max-height: 340px; padding: 4px 6px; }
.diary__row {
    border-left-width: 3px; border-left-color: #A89F8E;
    padding: 2px 6px; margin-bottom: 3px;
    background-color: rgba(255, 255, 255, 0.03);
}

/* Famiglia as a sidebar */
.sidebar {
    position: absolute; left: 0; top: 40px; bottom: 0; width: 500px;
    padding: 0; border-radius: 0; border-left-width: 0; border-top-width: 0;
    background-color: rgba(18, 15, 12, 0.96);
}
.sidebar__nav {
    flex-direction: row; flex-wrap: wrap; padding: 6px 10px 4px 10px;
    border-bottom-width: 1px; border-bottom-color: rgba(232, 194, 106, 0.18);
}
.sidebar__tab {
    padding: 4px 9px; margin: 0 4px 4px 0; border-radius: 3px;
    border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 255, 255, 0.04);
}
.sidebar__tab:hover { background-color: rgba(255, 255, 255, 0.09); }
.sidebar__tab--on { background-color: rgba(232, 194, 106, 0.18); border-bottom-color: #E8C26A; }
.root .sidebar__tabname { font-size: 12px; -unity-font-style: bold; color: #D9CFBB; }
.sidebar__tab--on .sidebar__tabname { color: #FFF4DA; }
.sidebar .famiglia__head { padding: 6px 14px 6px 14px; }
.sidebar .stat-card { width: 140px; }

.pill {
    height: 22px; padding: 0 9px; margin: 0 4px 4px 0; border-radius: 11px;
    font-size: 11px; background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px; border-color: rgba(232, 194, 106, 0.18);
}
.pill--small { height: 19px; font-size: 10px; padding: 0 7px; }
.pill--on { background-color: rgba(232, 194, 106, 0.22); border-color: #E8C26A; color: #FFF4DA; }
.filter-row { flex-wrap: wrap; margin-top: 6px; }
.search { height: 26px; margin: 2px 6px 2px 0; }
.back-btn { align-self: flex-start; }

.roster-row {
    flex-direction: row; align-items: center;
    padding: 5px 6px; margin-bottom: 2px; border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.025);
}
.roster-row:hover { background-color: rgba(232, 194, 106, 0.1); }

.org-node {
    flex-direction: row; align-items: center;
    padding: 6px 8px; margin: 4px 0; border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.04);
    border-left-width: 3px; border-left-color: #A89F8E;
}
.org-node--boss { border-left-color: #E8C26A; background-color: rgba(232, 194, 106, 0.1); }
.org-branch {
    margin: 8px 0 4px 12px; padding: 4px 0 6px 12px;
    border-left-width: 2px; border-left-color: rgba(232, 194, 106, 0.3);
}
.org-team { padding: 4px 6px; margin-right: 6px; border-radius: 4px; background-color: rgba(0, 0, 0, 0.25); min-height: 28px; }
.org-chip { padding: 2px 6px; margin: 2px 4px 2px 0; border-radius: 3px; background-color: rgba(255, 255, 255, 0.05); }
.org-chip:hover { background-color: rgba(232, 194, 106, 0.16); }

/* Build as a drawer */
.drawer { width: 980px; padding: 8px 12px 6px 12px; margin-bottom: 6px; }
.drawer__head { flex-direction: row; align-items: center; margin-bottom: 6px; }
.drawer__head .pill { margin-bottom: 0; }
.drawer__tool { margin-left: 4px; }
.drawer__scroll { height: 150px; }
.drawer__cards { flex-direction: row; }
.bcard {
    width: 112px; height: 140px; margin: 0 8px 0 0; padding: 8px 6px 6px 6px;
    flex-direction: column; align-items: center; justify-content: flex-start;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.06); border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.04);
}
.bcard:hover { border-color: rgba(232, 194, 106, 0.55); }
.bcard--on { border-color: #E8C26A; background-color: rgba(232, 194, 106, 0.18); }
.bcard--none { opacity: 0.55; }
.bcard__pic { width: 76px; height: 76px; border-radius: 4px; background-color: rgba(0, 0, 0, 0.35); -unity-background-scale-mode: scale-to-fit; }
.root .bcard__name { font-size: 12px; margin-top: 6px; -unity-text-align: middle-center; white-space: normal; }
.root .bcard__price { font-size: 12px; color: #E8C26A; -unity-font-style: bold; }
.root .bcard__stock {
    position: absolute; right: 5px; top: 5px; font-size: 10px; color: #F3E9D2;
    background-color: rgba(0, 0, 0, 0.6); border-radius: 3px; padding: 0 4px;
}
/* v3 layout: a taller top bar, everything below it moved down */
.topbar { height: 52px; }
.tb-group { padding-top: 3px; }
.root .tb-row .chip__value { font-size: 14px; }
.minimap { top: 58px; }
.goal { top: 232px; }
.feed { top: 266px; }
.crew-bar { top: 58px; }
.wanted { top: 62px; }
.sidebar { top: 52px; }
.mini-bar { height: 12px; }
.root .mini-bar__label { font-size: 8px; }
.dock--sidebar { left: 500px; }
.drawer__scroll { height: 166px; }
.drawer .tiny { margin-top: 2px; }

/* v3.1: from the mockups */
.sidebar--wide { width: 880px; }
.dock--sidebar-wide { left: 880px; }
.roster-col { width: 360px; margin-right: 14px; flex-shrink: 0; }
.detail-col { flex-grow: 1; flex-shrink: 1; min-width: 0; padding-left: 12px; border-left-width: 1px; border-left-color: rgba(232, 194, 106, 0.18); }
.rank-card {
    margin-top: 10px; padding: 8px 12px; border-radius: 5px;
    background-color: rgba(232, 194, 106, 0.07); border-width: 1px; border-color: rgba(232, 194, 106, 0.3);
}
.root .rank-card__title { font-size: 16px; letter-spacing: 2px; color: #E8C26A; -unity-font-style: bold; margin-bottom: 4px; }
.dock__tabs .tab { min-width: 120px; height: 42px; justify-content: flex-start; padding: 0 10px; }
.root .tab__sub { font-size: 9px; color: #A89F8E; margin-left: 6px; }
.dock__tabs .tab__key { margin-left: auto; }
.crew-bar { width: 200px; }
.crew-card { padding: 5px 7px; }
.crew-card .avatar { width: 38px; height: 38px; border-radius: 19px; }
.root .crew-card__name { font-size: 13px; }
.root .crew-card__status { font-size: 10px; }
.bcard { height: 152px; }
.bcard__foot { flex-direction: row; align-items: center; justify-content: space-between; align-self: stretch; padding: 0 4px; }
.root .bcard__perk { font-size: 9px; color: #A89F8E; }
.drawer__scroll { height: 178px; }
.root .sidebar { background-color: rgba(16, 13, 10, 0.97); }
.dock--sidebar-wide .tab { min-width: 92px; }
.dock--sidebar-wide .tab__sub { display: none; }

/* =====================================================================
   v4 look: one system for the HUD, after the mockups.
   Panels: near-black warm brown, thin gold border, 4px corners.
   Type: condensed caps for captions and titles, Barlow for reading.
   Spacing: 4 / 8 / 12 / 16.
   ===================================================================== */
.root .stat__cap, .root .stat__value, .root .stat__time, .root .stat__boss, .root .tab__label,
.root .news__title, .root .panel-head__title, .root .person__name, .root .section, .root .rank-card__title,
.root .sidebar__tabname, .root .tile__label, .root .role-chip {
    -unity-font-definition: resource("Fonts/BarlowCondensed-Bold");
    -unity-font-style: normal;
}
.root .stat__cap, .root .sidebar__tabname, .root .role-chip, .root .tile__label {
    -unity-font-definition: resource("Fonts/BarlowCondensed-SemiBold");
}
.root .roster__name, .root .field__value, .root .crew-card__name { -unity-font-definition: resource("Fonts/Barlow-Bold"); -unity-font-style: normal; }

.panel {
    background-color: rgba(17, 13, 9, 0.94);
    border-width: 1px; border-color: rgba(201, 160, 84, 0.35); border-top-color: rgba(201, 160, 84, 0.55);
    border-radius: 4px;
}
.btn { background-color: rgba(255, 255, 255, 0.04); border-color: rgba(201, 160, 84, 0.28); border-radius: 3px; }
.btn--on { background-color: rgba(227, 184, 98, 0.18); border-color: #E3B862; color: #FFF1D4; }
.root .section {
    font-size: 14px; letter-spacing: 2px; color: #E3B862;
    margin-top: 14px; margin-bottom: 6px; padding-bottom: 3px;
    border-bottom-width: 1px; border-bottom-color: rgba(201, 160, 84, 0.2);
}
.bar { height: 6px; border-radius: 3px; background-color: rgba(0, 0, 0, 0.6); }
.bar__fill { border-radius: 3px; }
.bar--thin { height: 4px; }

/* Top bar: stat blocks */
.topbar { height: 64px; padding: 0 8px; border-bottom-color: rgba(201, 160, 84, 0.55); }
.stat {
    flex-direction: row; align-items: center; height: 100%;
    padding: 0 16px; border-right-width: 1px; border-right-color: rgba(201, 160, 84, 0.18);
}
.stat--right { border-right-width: 0; }
.stat__icon { margin-right: 10px; }
.stat__col { flex-direction: column; justify-content: center; }
.root .stat__cap { font-size: 11px; letter-spacing: 1.5px; color: #9C9180; }
.root .stat__value { font-size: 22px; color: #F3E9D2; margin-top: -3px; }
.root .stat__sub { font-size: 11px; color: #B9A57A; margin-top: -2px; }
.root .stat__time { font-size: 28px; color: #F3E9D2; margin-bottom: -4px; }
.root .stat__boss { font-size: 15px; color: #CDBF9F; letter-spacing: 0.5px; }
.stat__bar { width: 72px; height: 4px; margin-top: 3px; border-radius: 2px; background-color: rgba(0, 0, 0, 0.6); overflow: hidden; }
.speeds { flex-direction: row; margin-left: 14px; }
.topbar .speed-btn { width: 34px; height: 30px; margin: 0 2px; border-radius: 3px; }

/* Everything hangs below the bar */
.minimap { top: 72px; right: 10px; width: 300px; height: 180px; border-radius: 4px; border-color: rgba(201, 160, 84, 0.55); }
.goal {
    top: 260px; right: 10px; width: 300px; padding: 8px 12px; font-size: 13px;
    background-color: rgba(17, 13, 9, 0.94); border-width: 1px; border-color: rgba(201, 160, 84, 0.35);
    border-left-width: 3px; border-left-color: #E3B862; border-radius: 4px;
}
.feed { top: 306px; right: 10px; width: 300px; }
.toast { background-color: rgba(17, 13, 9, 0.92); border-radius: 4px; padding: 6px 10px; margin-bottom: 4px; font-size: 12px; }
.wanted { top: 76px; }

/* Crew bar: portrait cards */
.crew-bar { top: 72px; left: 10px; width: 250px; }
.root .crew-bar__head { font-size: 11px; padding: 5px 10px; margin-bottom: 6px; background-color: rgba(17, 13, 9, 0.92); border-width: 1px; border-color: rgba(201, 160, 84, 0.3); border-radius: 4px; }
.crew-card {
    height: 62px; padding: 6px 10px; margin-bottom: 6px;
    background-color: rgba(17, 13, 9, 0.92); border-width: 1px; border-color: rgba(201, 160, 84, 0.25); border-radius: 4px;
}
.crew-card--selected { border-color: #E3B862; background-color: rgba(48, 37, 20, 0.95); }
.crew-card .avatar--card { width: 46px; height: 46px; border-radius: 23px; margin-right: 12px; border-width: 2px; border-color: rgba(201, 160, 84, 0.6); }
.root .crew-card__name { font-size: 15px; }
.root .crew-card__status { font-size: 12px; }

/* Bottom bar */
.dock { bottom: 0; left: 0; right: 0; }
.hotbar {
    align-self: stretch; height: 66px; flex-direction: row; align-items: center; padding: 0 12px;
    border-top-width: 1px; border-top-color: rgba(201, 160, 84, 0.55);
}
.hotbar .tab {
    height: 52px; min-width: 150px; margin: 0 4px; padding: 0 14px; border-radius: 4px;
    flex-direction: row; align-items: center; justify-content: flex-start;
    background-color: rgba(255, 255, 255, 0.03); border-width: 1px; border-color: rgba(201, 160, 84, 0.22);
}
.hotbar .tab:hover { border-color: rgba(227, 184, 98, 0.6); }
.hotbar .tab.btn--on { border-color: #E3B862; background-color: rgba(227, 184, 98, 0.16); }
.hotbar .tab--icon { min-width: 52px; justify-content: center; padding: 0; }
.root .hotbar .tab__label { font-size: 16px; letter-spacing: 1.5px; color: #F3E9D2; margin-left: 10px; }
.root .hotbar .tab__sub { font-size: 11px; color: #9C9180; margin-left: 10px; margin-top: -2px; }
.hotbar .tab__key { position: absolute; top: 4px; right: 6px; font-size: 9px; }
.news {
    width: 300px; height: 52px; flex-direction: row; align-items: center; padding: 0 12px; margin: 0;
    border-radius: 4px; background-color: rgba(255, 255, 255, 0.03); border-width: 1px; border-color: rgba(201, 160, 84, 0.22);
    -unity-text-align: middle-left;
}
.news__dot { width: 8px; height: 8px; border-radius: 4px; background-color: #5E574C; margin-right: 10px; flex-shrink: 0; }
.news--unread .news__dot { background-color: #E0483C; }
.root .news__title { font-size: 14px; letter-spacing: 1.5px; color: #F3E9D2; }
.root .news__text { font-size: 11px; color: #9C9180; white-space: nowrap; overflow: hidden; }
.diary { position: absolute; right: 12px; bottom: 74px; width: 380px; max-height: 420px; padding: 8px 10px; }
.vitals-bar { margin-bottom: 8px; padding: 5px 12px; background-color: rgba(17, 13, 9, 0.9); border-width: 1px; border-color: rgba(201, 160, 84, 0.25); border-radius: 4px; }
.drawer { margin-bottom: 8px; }
.build-hint { margin-bottom: 6px; }

/* Famiglia */
.sidebar { top: 64px; bottom: 66px; width: 520px; border-right-width: 1px; border-right-color: rgba(201, 160, 84, 0.45); }
.sidebar--wide { width: 920px; }
.panel-head { padding: 14px 16px 10px 16px; align-items: center; }
.panel-head__icon { margin-right: 12px; }
.root .panel-head__title { font-size: 30px; letter-spacing: 3px; color: #E3B862; }
.root .panel-head__tagline { font-size: 12px; color: #9C9180; margin-top: -2px; }
.sidebar__nav { padding: 8px 12px 6px 12px; }
.sidebar__tab {
    flex-grow: 1; flex-basis: 18%; height: 32px; margin: 0 4px 4px 0; padding: 0 6px;
    justify-content: center; align-items: center; border-radius: 3px;
    border-width: 1px; border-color: rgba(201, 160, 84, 0.22); background-color: rgba(255, 255, 255, 0.03);
}
.sidebar__tab--on { border-color: #E3B862; background-color: rgba(227, 184, 98, 0.16); border-bottom-width: 1px; }
.root .sidebar__tabname { font-size: 14px; letter-spacing: 1px; -unity-text-align: middle-center; }
.sidebar .famiglia__head { padding: 8px 16px; }
.sidebar .window__body { padding: 8px 16px; }

.roster-row {
    height: 64px; padding: 6px 10px; margin-bottom: 4px; border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.03); border-width: 1px; border-color: rgba(0, 0, 0, 0);
}
.roster-row:hover { border-color: rgba(227, 184, 98, 0.4); background-color: rgba(227, 184, 98, 0.06); }
.roster-row--on { border-color: #E3B862; background-color: rgba(227, 184, 98, 0.1); }
.avatar--row { width: 46px; height: 46px; border-radius: 23px; margin-right: 12px; border-width: 2px; border-color: rgba(201, 160, 84, 0.6); }
.root .roster__name { font-size: 15px; }
.root .roster__status { font-size: 11px; color: #9C9180; }
.roster__bar { width: 120px; margin-top: 4px; }
.roster__info { align-items: flex-end; margin-right: 14px; width: 84px; }
.root .role-chip { font-size: 12px; color: #E3B862; border-width: 1px; border-color: rgba(201, 160, 84, 0.4); border-radius: 3px; padding: 1px 7px; }
.root .roster__wage { font-size: 11px; color: #9C9180; margin-top: 3px; }
.presence { flex-direction: row; align-items: center; width: 74px; }
.presence__dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 6px; }
.dot-good { background-color: #6CC46A; }
.dot-warn { background-color: #E8A23C; }
.dot-bad { background-color: #E0483C; }
.dot-off { background-color: #6B6458; }
.root .presence__text { font-size: 11px; color: #CDBF9F; }
.roster-col { width: 380px; }

.person-head { flex-direction: row; align-items: center; padding: 4px 0 12px 0; }
.avatar--hero { width: 76px; height: 76px; border-radius: 38px; margin-right: 14px; border-width: 2px; border-color: #E3B862; }
.root .person__name { font-size: 26px; color: #F3E9D2; letter-spacing: 0.5px; }
.root .person__role { font-size: 13px; color: #9C9180; }
.root .person__status { font-size: 12px; color: #E3B862; margin-top: 2px; }
.person__close { align-self: flex-start; }
.field {
    flex-direction: row; align-items: center; height: 34px; padding: 0 8px;
    border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.06);
}
.field--click:hover { background-color: rgba(227, 184, 98, 0.08); }
.root .field__label { font-size: 13px; color: #9C9180; width: 110px; }
.root .field__value { font-size: 13px; flex-grow: 1; -unity-text-align: middle-right; }
.root .field__chev { font-size: 18px; color: #E3B862; margin-left: 8px; }
.field__btn { width: 26px; margin-left: 6px; }
.tiles { flex-direction: row; flex-wrap: wrap; }
.tile {
    width: 92px; height: 62px; margin: 0 6px 6px 0; padding: 0;
    flex-direction: column; align-items: center; justify-content: center;
}
.root .tile__glyph { font-size: 20px; color: #E3B862; }
.root .tile__label { font-size: 12px; letter-spacing: 0.5px; }
/* v4 fixes */
.root .stat__col > .unity-label, .root .stat__col > Label { margin: 0; padding: 0; }
.root .stat__value { margin-top: 0; }
.root .stat__sub { margin-top: 0; }
.root .stat__time { margin: 0; padding: 0; }
.root .stat--clock .stat__cap { margin: 0; padding: 0; }
.inspector { left: 10px; bottom: 76px; }
.hotbar .tab { width: 150px; min-width: 0; }
.hotbar .tab--icon { width: 52px; }
.root .sidebar { background-color: rgb(17, 13, 10); }
.sidebar__tab { flex-grow: 0; flex-basis: auto; width: 18.4%; }

/* =====================================================================
   v5: painted pieces from Tools/ArtGen/ui.py (Resources/UI/Art), drawn at 2x.
   Frames and buttons are 9-slice; -unity-slice-scale 0.5 brings them back to screen size.
   ===================================================================== */
.panel {
    background-image: resource("UI/Art/frame_panel");
    -unity-slice-left: 28; -unity-slice-right: 28; -unity-slice-top: 28; -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 14px 16px;
}
.root .sidebar { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.minimap { background-image: none; background-color: rgb(18, 17, 16); border-width: 2px; border-color: rgba(201, 160, 84, 0.7); padding: 0; }

.btn {
    background-image: resource("UI/Art/button_normal");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    -unity-slice-scale: 0.5;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.btn:hover { background-image: resource("UI/Art/button_hover"); background-color: rgba(0, 0, 0, 0); }
.btn--on, .btn:active, .pill--on { background-image: resource("UI/Art/button_active"); background-color: rgba(0, 0, 0, 0); color: #24190C; }
.bcard--on { background-image: resource("UI/Art/button_hover"); }
.root .btn--on .tab__label, .root .pill--on, .root .sidebar__tab--on .sidebar__tabname { color: #24190C; }
.root .btn--on .tab__sub { color: #5A4320; }
.root .hotbar .tab.btn--on { background-color: rgba(0, 0, 0, 0); }
.hotbar .tab, .hotbar .tab:hover, .news { border-width: 0; }
.hotbar .tab:hover { background-image: resource("UI/Art/button_hover"); }

.sidebar__tab {
    background-image: resource("UI/Art/button_normal");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    -unity-slice-scale: 0.5;
    background-color: rgba(0, 0, 0, 0); border-width: 0;
}
.sidebar__tab:hover { background-image: resource("UI/Art/button_hover"); background-color: rgba(0, 0, 0, 0); }
.sidebar__tab--on { background-image: resource("UI/Art/button_active"); background-color: rgba(0, 0, 0, 0); }

.topbar {
    background-image: resource("UI/Art/bar_strip");
    -unity-slice-left: 8; -unity-slice-right: 8; -unity-slice-top: 0; -unity-slice-bottom: 10;
    -unity-slice-scale: 0.5;
    border-bottom-width: 0;
}
.art-icon { -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.stat__icon.art-icon { margin-right: 10px; }

/* v5.1: near-black everywhere; gold only on rims, icons and text */
.btn--on, .btn:active, .pill--on { color: #F2CF7A; }
.root .btn--on .tab__label, .root .pill--on, .root .sidebar__tab--on .sidebar__tabname { color: #F2CF7A; }
.root .btn--on .tab__sub { color: #B9A57A; }
.roster-row { background-color: rgba(0, 0, 0, 0.35); border-color: rgba(201, 160, 84, 0.12); }
.roster-row:hover { background-color: rgba(0, 0, 0, 0.5); border-color: rgba(227, 184, 98, 0.45); }
.roster-row--on { background-color: rgba(0, 0, 0, 0.55); border-color: #E3B862; }
.field--click:hover { background-color: rgba(0, 0, 0, 0.45); }
.crew-card { background-color: rgba(10, 8, 6, 0.95); }
.crew-card--selected { background-color: rgba(10, 8, 6, 0.98); border-color: #E3B862; }
.goal, .toast, .vitals-bar, .root .crew-bar__head { background-color: rgba(10, 8, 6, 0.95); }
.rank-card { background-color: rgba(0, 0, 0, 0.4); }
.attention { background-color: rgba(0, 0, 0, 0.35); }
.stat-card { background-color: rgba(0, 0, 0, 0.4); }
.org-node, .org-team, .org-chip { background-color: rgba(0, 0, 0, 0.35); }
.org-node--boss { background-color: rgba(0, 0, 0, 0.5); }
.bcard { background-color: rgba(0, 0, 0, 0.35); }
.hotbar { background-color: rgb(10, 8, 6); }
